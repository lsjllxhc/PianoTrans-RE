<Page
    x:Class="PianoTrans.WUI50.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PianoTrans.WUI50.Models"
    NavigationCacheMode="Required"
    AllowDrop="True"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Background="Transparent">

    <Grid Padding="28,20,28,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="OpenButton" Click="OpenFiles_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="OpenFile" />
                    <TextBlock Text="打开文件" />
                </StackPanel>
            </Button>

            <Button x:Name="StartButton" Click="Start_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Play" />
                    <TextBlock Text="开始" />
                </StackPanel>
            </Button>

            <Button x:Name="StopButton" Click="Stop_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Stop" />
                    <TextBlock Text="停止" />
                </StackPanel>
            </Button>

            <Button x:Name="ClearButton" Click="ClearFinished_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Clear" />
                    <TextBlock Text="清理已完成" />
                </StackPanel>
            </Button>

            <TextBlock
                x:Name="DropHint"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="也可以把音频 / 视频文件直接拖进这个窗口" />
        </StackPanel>

        <ListView
            x:Name="JobsList"
            Grid.Row="1"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding InputPath}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding OutputPath}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding StageText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                            <ProgressBar Maximum="100" Value="{Binding Progress}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding ProgressText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding ElapsedText}" />
                            <Button Padding="8,4" Click="RemoveJob_Click" Content="移除" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar
            x:Name="Info"
            Grid.Row="2"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational"
            Title="PianoTrans" />
    </Grid>
</Page>
