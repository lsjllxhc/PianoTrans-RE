<Page
    x:Class="PianoTrans.WUI50.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer Padding="28,20,28,20">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <RadioButtons
                        x:Name="LanguageRadio"
                        Header="界面语言"
                        MaxColumns="2"
                        SelectionChanged="LanguageRadio_SelectionChanged">
                        <RadioButton Content="中文" />
                        <RadioButton Content="English" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <RadioButtons
                        x:Name="DeviceRadio"
                        Header="推理设备"
                        MaxColumns="2"
                        SelectedIndex="0"
                        SelectionChanged="DeviceRadio_SelectionChanged">
                        <RadioButton Content="GPU（50 系 / CUDA 12.8）" />
                        <RadioButton Content="CPU" />
                    </RadioButtons>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="GPU 模式下如果没有可用 CUDA 设备，后端会自动回退到 CPU。" />
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="输出文件夹" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="OutputFolderBox"
                            Grid.Column="0"
                            LostFocus="OutputFolderBox_LostFocus"
                            PlaceholderText="选择 MIDI 输出文件夹" />
                        <Button Grid.Column="1" Click="BrowseOutput_Click" Content="浏览…" />
                        <Button Grid.Column="2" Click="OpenOutput_Click" Content="打开输出文件夹" />
                    </Grid>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="生成的 MIDI 会使用输入文件名，并保存到这个文件夹。" />
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <NumberBox
                        x:Name="MinNoteBox"
                        Header="最短音符时长"
                        Minimum="0.01"
                        Maximum="2"
                        SmallChange="0.01"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="MinNoteBox_ValueChanged" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="短于这个时长的音符会在写 MIDI 前被过滤掉（秒）。" />
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="识别参数" />

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <NumberBox
                            x:Name="OnsetThresholdBox"
                            Grid.Column="0"
                            Header="Onset 阈值"
                            Minimum="0.01"
                            Maximum="0.99"
                            SmallChange="0.01"
                            SpinButtonPlacementMode="Inline" />
                        <NumberBox
                            x:Name="OffsetThresholdBox"
                            Grid.Column="1"
                            Header="Offset 阈值"
                            Minimum="0.01"
                            Maximum="0.99"
                            SmallChange="0.01"
                            SpinButtonPlacementMode="Inline" />
                        <NumberBox
                            x:Name="FrameThresholdBox"
                            Grid.Column="2"
                            Header="Frame 阈值"
                            Minimum="0.01"
                            Maximum="0.99"
                            SmallChange="0.01"
                            SpinButtonPlacementMode="Inline" />
                        <NumberBox
                            x:Name="PedalOffsetThresholdBox"
                            Grid.Column="3"
                            Header="踏板 Offset"
                            Minimum="0.01"
                            Maximum="0.99"
                            SmallChange="0.01"
                            SpinButtonPlacementMode="Inline" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <NumberBox
                            x:Name="OnsetNeighborBox"
                            Grid.Column="0"
                            Header="Onset 峰值邻域"
                            Minimum="1"
                            Maximum="8"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline" />
                        <NumberBox
                            x:Name="OffsetNeighborBox"
                            Grid.Column="1"
                            Header="Offset 峰值邻域"
                            Minimum="1"
                            Maximum="8"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline" />
                        <NumberBox
                            x:Name="PedalNeighborBox"
                            Grid.Column="2"
                            Header="踏板峰值邻域"
                            Minimum="1"
                            Maximum="8"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <NumberBox
                            x:Name="BpmBox"
                            Grid.Column="0"
                            Header="MIDI BPM"
                            Minimum="20"
                            Maximum="300"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline" />
                        <NumberBox
                            x:Name="OverlapBox"
                            Grid.Column="1"
                            Header="分段重叠率 (%)"
                            Minimum="0"
                            Maximum="75"
                            SmallChange="5"
                            SpinButtonPlacementMode="Inline" />
                        <NumberBox
                            x:Name="BatchSizeBox"
                            Grid.Column="2"
                            Header="推理批大小"
                            Minimum="1"
                            Maximum="8"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline" />
                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Bottom"
                            Click="ResetRecognition_Click"
                            Content="恢复默认" />
                    </Grid>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="重叠率越高，段边界错误越少但推理越慢；0 表示无重叠、速度最快。帮助页有每个参数的详细说明。" />
                </StackPanel>
            </Border>

            <Button
                x:Name="SaveButton"
                Click="Save_Click"
                Content="保存设置"
                Style="{StaticResource AccentButtonStyle}" />

            <InfoBar
                x:Name="Info"
                IsClosable="True"
                IsOpen="False"
                Severity="Success"
                Title="设置已保存" />
        </StackPanel>
    </ScrollViewer>
</Page>
